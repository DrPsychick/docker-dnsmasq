echo "### DMQ_GLOBAL*"
for v in $(set | grep ^DMQ_GLOBAL| sed -e 's/^\(DMQ_GLOBAL[^=]*\).*/\1/' | sort -r | tr '\n', ' '); do
  val=$(eval echo "\$$v")
  [ -z "$v" -o -z "$val" ] && continue
  echo -e "$val"
done
